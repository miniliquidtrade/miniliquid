# Copy to .env.local and fill in. All values are client-side (NEXT_PUBLIC_*)
# configuration — none are secrets.

# Required: your Privy app ID for wallet login (https://privy.io).
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: canonical site URL, used for absolute social-card (OG) image URLs.
# On Vercel this falls back to the deployment URL automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: set to "true" to sponsor gas for embedded wallets.
NEXT_PUBLIC_PRIVY_APP_SPONSORS_GAS=

# Optional: preferred card on-ramp provider for the Privy funding flow.
NEXT_PUBLIC_PRIVY_ONRAMP_PROVIDER=
